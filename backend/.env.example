# Copia a .env (uvicorn no lo lee solo; expórtalas en la terminal o en Vercel).
# Local (por defecto): SQLite sin contraseña.
MINIMARKET_DATABASE_URL=sqlite:///./minimarket.db
SIM_DB_SCHEMA=
SIM_ACCESS_PASSWORD=
SIM_ACCESS_SESSION_HOURS=12
SIM_CORS_ORIGINS=

# Internet (Vercel + Supabase), ver docs/despliegue.md:
# MINIMARKET_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<clave>@<host-pooler>:6543/postgres
# SIM_DB_SCHEMA=sim
# SIM_ACCESS_PASSWORD=una-contraseña-larga
# SIM_CORS_ORIGINS=https://sim.eunomi.cl
